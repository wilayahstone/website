{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "@store/runtime-env": [
        "./lib/server/env-node.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next-vercel/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "dist",
    ".vinext",
    ".wrangler",
    ".sites-runtime",
    "outputs",
    "work",
    "supabase/functions",
    ".next"
  ]
}
